# Scripts stay off for a plain npm ci. ignore-scripts overrides allowScripts.
# The Electron download is: npm ci --ignore-scripts=false
# Electron 44 has no dependency install script. The root postinstall runs
# node node_modules/electron/install.js when scripts are enabled.
# allowScripts still permits only electron@44.9.3 on npm 11 and npm 12.
# npm 10.9.9, bundled with Node 22.23.3, has no allowlist.
ignore-scripts=true
